# _Browser — Linux release build config
#
# Usage (from inside the cloned Firefox source tree):
#   export MOZCONFIG="$PWD/../_browser/fork/mozconfig/mozconfig.linux.release"
# or copy this file to the source root as ".mozconfig".
# The build.sh helper wires this up for you.

# Build the browser application (Firefox chrome layer).
ac_add_options --enable-application=browser

# Release build: optimized, assertions/debug info off.
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --enable-release

# Custom _Browser branding. The directory browser/branding/_browser is created
# by fork/scripts/apply-overlay.sh (seeded from Firefox's "unofficial" branding).
ac_add_options --with-branding=browser/branding/_browser

# Keep release artifacts in their own object directory so debug/release don't clash.
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-_browser-release

# Parallelism is auto-detected from CPU count. Uncomment to pin the job count:
# mk_add_options MOZ_MAKE_FLAGS="-j8"
